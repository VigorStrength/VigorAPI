{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["exerciseIds"],
    "properties": {
      "_id": {
        "bsonType": "objectId",
        "description": "must be an objectId"
      },
      "exerciseIds": {
        "bsonType": "array",
        "minItems": 2,
        "items": {
          "bsonType": "objectId",
          "description": "Array of exercise IDs that are part of the superset"
        }
      }
    }
  }
}
